# ── Spotify app credentials (from https://developer.spotify.com/dashboard) ──
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI registered in your Spotify app settings.
# After deploying, this is your public URL + /callback. Example:
#   https://spotify-mcp-yourname.onrender.com/callback
# Spotify no longer allows "localhost"; for local testing use 127.0.0.1.
SPOTIFY_REDIRECT_URI=https://YOUR-DEPLOYED-URL/callback

# Filled in AFTER you visit /login once and copy the token it prints.
# Leave blank on the very first deploy.
SPOTIFY_REFRESH_TOKEN=

# Optional: enables real similarity in spotify_find_similar via Last.fm.
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Most cloud hosts set PORT automatically; only set locally if you want.
# PORT=8000
